{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/islands/**/*.ts", "src/demos/**/*.ts", "src/snippets/*.ts", "src/data/pages.ts", "src/data/schema.ts", "src/data/site.ts", "src/data/parts.ts"],
  "exclude": ["dist", "src/snippets/layout.ts", "src/snippets/drag.ts", "src/snippets/pair-motion.ts", "src/snippets/pair-placement.ts"]
}
