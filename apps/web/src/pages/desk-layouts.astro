---
import Site from "../layouts/Site.astro";
import CaseRail from "../components/CaseRail.astro";
import { pageOf } from "../data/pages";
import { webPage, breadcrumbs, orgNode } from "../data/schema";
import { ASPECTS, BOTTOM_MODES, CARDS, DEFAULT, DEFAULT_OPTS, TABLE, TOOLBAR_MODES, deskSVG, layout } from "../demos/desk";
import "../styles/desk-layouts.css";

const path = "/desk-layouts/";
const page = pageOf(path);
const jsonLd = [
  webPage({ path, name: page.title, description: page.description, updated: new Date(`${page.updated}T00:00:00Z`) }),
  breadcrumbs([{ name: "Home", path: "/" }, { name: page.nav, path }]),
  orgNode,
];
const active = CARDS.findIndex((c) => c.pick);
const first = CARDS[active]!;
const { boxes, notes } = layout(first.key, DEFAULT.W, DEFAULT.H, DEFAULT.n, DEFAULT_OPTS);
const pct = (v: number, min: number, max: number) => `--fill:${((v - min) / (max - min)) * 100}%`;
const presets: [string, string][] = [["1440,820", "Large"], ["960,560", "Laptop"], ["760,420", "Short"], ["520,700", "Narrow"]];
const plain = (html: string) => html.replace(/<[^>]+>/g, "");
---
<Site title={page.title} description={page.description} path={path} headline="Nine ways to build a desk, and what each gives way." jsonLd={jsonLd} ogImage="/og/desk-layouts.png">
  <p class="lead" slot="lead">This page lays out one desk nine ways: a toolbar, five tool panels (Files, Outline, Notes, Inspector, History) and a few open documents. Pick a construction and the stage lays it out live by that construction's own rules. Drag the sliders to see what gives way when width or height runs out; every box settles to its new place from wherever it is drawn.</p>

  <figure class="figure deskfig" id="figure" aria-label="Desk layouts: nine constructions laid out live at a size you choose">
    <div class="figure-bar">
      <label class="field">Width <input id="w" type="range" min="480" max="1440" step="10" value={DEFAULT.W} style={pct(DEFAULT.W, 480, 1440)} /><output id="wo">{DEFAULT.W}</output></label>
      <label class="field">Height <input id="h" type="range" min="320" max="820" step="10" value={DEFAULT.H} style={pct(DEFAULT.H, 320, 820)} /><output id="ho">{DEFAULT.H}</output></label>
      <label class="field">Documents <input id="n" type="range" min="1" max="4" step="1" value={DEFAULT.n} style={`width:84px;${pct(DEFAULT.n, 1, 4)}`} /><output id="no">{DEFAULT.n}</output></label>
      <span class="spacer"></span>
      <span class="seg" id="presets" role="group" aria-label="Presets">
        {presets.map(([p, l]) => <button type="button" data-p={p} aria-pressed={String(p === `${DEFAULT.W},${DEFAULT.H}`)}>{l}</button>)}
      </span>
    </div>
    <div class="figure-bar sub" id="segs">
      <div class="field"><span class="label">Toolbar</span><span class="seg">{TOOLBAR_MODES.map((m) => <button type="button" aria-pressed={String(m[0] === DEFAULT_OPTS.toolbar && m[1] === DEFAULT_OPTS.toolbarSpace)}>{m[2]}</button>)}</span></div>
      <div class="field"><span class="label">Bottom dock</span><span class="seg">{BOTTOM_MODES.map((m) => <button type="button" aria-pressed={String(m[0] === DEFAULT_OPTS.bottom && m[1] === DEFAULT_OPTS.bottomSpace)}>{m[2]}</button>)}</span></div>
    </div>
    <div class="figure-body">
      <CaseRail id="cases" label="Constructions" items={CARDS.map((c) => ({ name: c.title, note: c.note, tag: c.pick ? "default" : undefined }))} active={active} />
      <div class="stage-wrap"><div id="stage">
        <svg id="desk" role="img" aria-label={`${first.title} desk layout`} viewBox={`0 0 ${DEFAULT.W} ${DEFAULT.H}`} width={DEFAULT.W} height={DEFAULT.H} style={`--w:${DEFAULT.W};--h:${DEFAULT.H}`} set:html={deskSVG(DEFAULT.W, DEFAULT.H, boxes)} />
      </div></div>
    </div>
    <figcaption class="figure-foot">
      <span class="status" id="status" role="status">{notes.length ? <><b>Gives way:</b> {notes.join("; ")}</> : <><b>Everything fits</b> at its natural size.</>}</span>
      <span class="idea" id="idea" set:html={first.idea} />
      <span class="legend">
        <span style="--c: var(--d-ink); --b: var(--d-ink)">toolbar</span><span style="--c: var(--d-panel); --b: var(--d-panel-line)">panel</span><span style="--c: var(--d-rail)">rail / tabs</span><span style="--c: var(--d-doc); --b: var(--d-doc-line)">document</span><span style="--c: var(--d-float-head); --b: var(--d-float-line)">floats over the documents</span><span style="--c: transparent; --b: var(--accent)">bottom dock</span>
      </span>
    </figcaption>
  </figure>

  <section class="section">
    <div class="section-head">
      <span class="eyebrow">The constructions</span>
      <p class="section-title">Docks, a tiling tree, a strip, drawers and palettes</p>
    </div>
    <div class="rules two">
      {CARDS.map((c) => <div class="rule"><h2>{c.title}{c.pick && <span class="tag">default</span>}</h2><p>{plain(c.idea)}</p></div>)}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <span class="eyebrow">How they compare</span>
      <p class="section-title">Eight questions, nine answers</p>
    </div>
    <div class="table-scroll compare-scroll">
      <table class="table compare" id="compare">
        <thead><tr><th scope="col">Construction</th>{ASPECTS.map((a) => <th scope="col">{a}</th>)}</tr></thead>
        <tbody>{CARDS.map((c, i) => <tr data-key={c.key} aria-current={String(i === active)}><th scope="row">{c.title}</th>{TABLE[c.key]!.map((t) => <td>{t}</td>)}</tr>)}</tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <div class="callout">
      <span class="eyebrow">The default</span>
      <h2>F3 · Edge docks + tear-off</h2>
      <p>One rule by default: a panel lives in a dock, and a dock folds to its rail. Short on height, sections fold to their headers; short on width, a whole dock folds to its rail. Nothing covers the documents unless you choose it: tear a panel off and it floats, drop it on a dock or its rail icon and it docks again. The toolbar is a floating pill, top or bottom. Every glide is a dock, a section or a palette opening, closing or moving, which <a href="/window-motion/">settle</a> already does. A is the same without floating; C is the simplest if one panel per side is enough.</p>
    </div>
  </section>
</Site>

<script>
  import { whenVisible } from "../islands/rail";
  whenVisible(document.getElementById("figure")!, () => void import("../islands/desk-layouts"));
</script>
