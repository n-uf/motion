---
import Site from "../layouts/Site.astro";
import ExtLink from "../components/ExtLink.astro";
import HeroDemo from "../components/HeroDemo.astro";
import HeroScope from "../components/HeroScope.astro";
import LoopStrip from "../components/LoopStrip.astro";
import Telemetry from "../components/Telemetry.astro";
import Poster from "../components/Poster.astro";
import { pageOf } from "../data/pages";
import { npmPlacementUrl, npmUrl, repoUrl } from "../data/site";
import { orgNode, software, webPage, webSite } from "../data/schema";
import Faq from "../components/Faq.astro";
import { faqJsonLd } from "../data/faq";
import { CURVE, curveSVG, deskThumbSVG } from "../demos/home";
import "../styles/home.css";
import "../styles/hero.css";
import "../styles/telemetry.css";
import "../styles/poster.css";
import CodeTabs from "../components/CodeTabs.astro";
import PairCode from "../components/PairCode.astro";
import { partOf } from "../data/parts";
import motionPkg from "../../../../packages/motion/package.json";
import placementPkg from "../../../../packages/placement/package.json";
const [motionPart, placementPart] = [partOf("motion"), partOf("placement")];

const page = pageOf("/");
const jsonLd = [
  webSite,
  webPage({ path: "/", name: page.title, description: page.description, updated: new Date(`${page.updated}T00:00:00Z`), isPartOf: true, about: ["motion", "placement"] }),
  software("motion"),
  software("placement"),
  faqJsonLd("/"),
  orgNode,
];
// The packages' versions, read from their package.json at build time (never written by hand).
const versions = motionPkg.version === placementPkg.version ? `both at ${motionPkg.version}` : `@n-uf/motion ${motionPkg.version}, @n-uf/placement ${placementPkg.version}`;
---
<Site title={page.title} description={page.description} path="/" jsonLd={jsonLd} ogImage="/og.png">
  <!--
    The two heroes, motion's scope left and placement's plan right (components/HeroScope.astro): the page's one h1 is
    their two headlines, and the TypeScript sentence is its first paragraph in the DOM, under the band on screen.
  -->
  <HeroScope />

  <!--
    The loop, second on the page, right under the hero: the live desk window first, then its legend, the four steps of a
    drag (each by its package, lit live while you drag the desk), and only then the section head that says why they come
    together, the claims and the caveat. The two telemetry panes that watch the desk are a section further down.
  -->
  <section class="wrap section loop" aria-labelledby="loop-title">
    <HeroDemo id="demo-fig" label="Live demo: three windows that glide between layouts and swap when dragged; X-ray shows each package's layer" />
    <LoopStrip />
    <div class="section-head">
      <span class="eyebrow">The loop</span>
      <h2 id="loop-title">Why they come together</h2>
      <p>One desktop-style UI, two questions, plain data in between. Placement answers where; motion answers how it gets there and, while you drag, what you mean.</p>
    </div>
    <ul class="loop-claims">
      <li><b>What you see is what you get:</b> the preview and the drop come from the same data.</li>
      <li><b>Every layout change animates:</b> any rects, one settle.</li>
      <li><b>The real element moves:</b> no copies, it lands from where you let go.</li>
      <li><b>Neither imports the other:</b> plain data between them, any framework or none.</li>
    </ul>
    <p class="caveat">The demo windows' slots are rects from placement's dock constructions, and they glide on motion's settle; the swap's drag intent is the site's own port of the rules. The hero at the top runs the packages' own drag (<code>createDragIntent</code>, <code>holdItem</code>), and the examples below are compiled against both packages. Young and still changing: {versions}, versioned together by date, so pin an exact one. <ExtLink href={repoUrl}>Source on GitHub</ExtLink> · on npm: <ExtLink href={npmUrl}>@n-uf/motion</ExtLink>, <ExtLink href={npmPlacementUrl}>@n-uf/placement</ExtLink></p>
  </section>

  <!-- What each package does: the heroes' two columns again, entry by entry (checked against each package.json). -->
  <section class="wrap section does" aria-labelledby="does-title">
    <div class="section-head">
      <span class="eyebrow">The packages</span>
      <h2 id="does-title">What each package does</h2>
    </div>
    <div class="does-grid">
      <article class="does-col m" aria-labelledby="does-motion">
        <h3 id="does-motion"><code>@n-uf/motion</code> <span>how things move</span></h3>
        <p>For desktop-style web apps with windows, panels, docks and toolbars: every change of layout moves the way a good tiling window manager does, and a drag reads what you mean. You give it rects and pointer samples; it moves the real elements.</p>
        <dl class="entries">
          <div><dt><code>@n-uf/motion</code></dt><dd>The frame loop on an injected clock, signals, springs and tweens with the settle, and the gesture recogniser; each also on its own as <code>./clock</code>, <code>./signals</code>, <code>./values</code>, <code>./gestures</code>.</dd></div>
          <div><dt><code>./layout</code></dt><dd>Give items rects: the real elements settle there, size changes revealed, never stretched; a held drag (<code>holdItem</code>), FLIP for DOM groups, reduced motion and batched drawing.</dd></div>
          <div><dt><code>./drag</code></dt><dd>The drag intent: aiming, priority, hysteresis, the switch hold, room after a delay, a drop that lands where it was shown, and the three previews.</dd></div>
          <div><dt><code>./gestures</code></dt><dd>Gestures alone: the recogniser, wheel classification, a frame coalescer, and dwell, touch-press and paged-swipe machines.</dd></div>
          <div><dt><code>./browser</code></dt><dd>The <code>requestAnimationFrame</code> clock and the reduced-motion query.</dd></div>
          <div><dt><code>./testing</code></dt><dd>Frame-sampled checks of the motion rules: no overshoot, no jumps, held under the pointer, monotonic, tempo, and content scale.</dd></div>
        </dl>
        <p class="not"><b>It doesn't</b> decide where anything goes, and it draws nothing of its own. The core touches no DOM; no framework.</p>
        <p class="links"><code class="cmd"><span class="prompt" aria-hidden="true">$</span> npm i @n-uf/motion</code> <ExtLink href={motionPart.readme}>README on GitHub</ExtLink></p>
      </article>
      <article class="does-col p" aria-labelledby="does-placement">
        <h3 id="does-placement"><code>@n-uf/placement</code> <span>where things go</span></h3>
        <p>For the same apps: it works out where windows, panels and toolbar groups go, as the space changes and while something is dragged. You give it state and a size; it gives back rects, notes on what gave way, and drop targets.</p>
        <dl class="entries">
          <div><dt><code>@n-uf/placement</code></dt><dd>Rects and points (<code>rect</code>, <code>overlap</code>, <code>clampInto</code>) and a popup positioner that flips, slides and resizes to fit.</dd></div>
          <div><dt><code>./dock</code></dt><dd>Nine desk constructions as pure layouts (edge docks, a tiling tree, a navigator, a scrolling strip, drawers, floating palettes, tear-off), with give-way notes whose codes are stable.</dd></div>
          <div><dt><code>./toolbar</code></dt><dd>Toolbar groups in five hosts × three zones, or floating; insertion points, and trailing-first collapse when a host runs out of room.</dd></div>
          <div><dt><code>./targets</code></dt><dd>Drop targets in the shape motion's drag takes, for the desk's constructions, toolbar hosts and pane zones.</dd></div>
        </dl>
        <p class="not"><b>It doesn't</b> move or draw anything: plain state in, rects and targets out. No DOM, no dependencies.</p>
        <p class="links"><code class="cmd"><span class="prompt" aria-hidden="true">$</span> npm i @n-uf/placement</code> <ExtLink href={placementPart.readme}>README on GitHub</ExtLink></p>
      </article>
    </div>
    <p class="does-together"><b>Alone or together.</b> They compose without importing each other: placement's targets are what motion's drag takes, and its rects are what motion's layout glides to.</p>
  </section>

  <!-- Use one, or both: three cards, then one example per package (each compiled against it). -->
  <section class="wrap section use-pair" aria-labelledby="use-pair-title">
    <div class="section-head">
      <span class="eyebrow">Use one, or both</span>
      <h2 id="use-pair-title">Pick what you need</h2>
    </div>
    <div class="use-cards">
      <div class="use-card m"><h3>Motion alone</h3><p>Animate your own layout: give each element its rect and it glides there.</p></div>
      <div class="use-card p"><h3>Placement alone</h3><p>Compute layouts and drop targets, and draw them your way.</p></div>
      <div class="use-card both"><h3>Both</h3><p>A full desk where the drop is what was shown, and every change glides.</p></div>
    </div>
    <PairCode />
  </section>

  <CodeTabs />

  <!-- The two panes behind the desk at the top: the frames of its last move and the rects placement gave it (islands/telemetry.ts). -->
  <section class="wrap section tele-sec" aria-labelledby="tele-title">
    <div class="section-head">
      <h2 id="tele-title">The last move, frame by frame</h2>
    </div>
    <Telemetry />
  </section>

  <!-- Explore: the four demo pages, grouped by package. -->
  <section class="wrap section explore" aria-labelledby="explore-title">
    <div class="section-head">
      <span class="eyebrow">Explore</span>
      <h2 id="explore-title">Interactive pages</h2>
    </div>
    <p class="explore-k m">Move · <code>{motionPart.pkg}</code></p>
    <div class="cards">
      <article class="card">
        <div class="thumb"><svg id="thumb-motion" viewBox={`0 0 ${CURVE.W} ${CURVE.H}`} width={CURVE.W} height={CURVE.H} aria-hidden="true" set:html={curveSVG(CURVE.Tms)} /></div>
        <div class="card-body"><span class="eyebrow"><span class="n">01</span> Window motion</span><h3><a href="/window-motion/">Settle against springs and tweens</a></h3><p>Curves from real parameters, a drag timeline, a retarget mid-flight, and stretch versus reveal frame by frame.</p></div>
      </article>
      <article class="card">
        <div class="thumb"><div class="t-stage" id="thumb-drag" aria-hidden="true"><i class="t-z" style="left:14px;top:14px;width:62px;height:70px"></i><i class="t-z home" style="left:14px;top:92px;width:62px;height:44px"></i><i class="t-z doc" style="left:84px;top:14px;width:94px;height:122px"></i><i class="t-z" style="left:186px;top:14px;width:80px;height:40px"></i><i class="t-z" style="left:186px;top:96px;width:80px;height:40px"></i><i class="t-ind" style="left:186px;top:58px;width:80px;height:34px"></i><i class="t-chip" style="transform:translate(14px,99px)"></i></div></div>
        <div class="card-body"><span class="eyebrow"><span class="n">02</span> Drag intent</span><h3><a href="/drag-intent/">An indicator only once you aim</a></h3><p>Drag a panel yourself or replay recorded paths, and count the indicator's flashes in this model and a naive one.</p></div>
      </article>
    </div>
    <p class="explore-k p">Place · <code>{placementPart.pkg}</code></p>
    <div class="cards">
      <article class="card">
        <div class="thumb"><svg id="thumb-desk" viewBox="0 0 280 150" width="280" height="150" aria-hidden="true" set:html={deskThumbSVG()} /></div>
        <div class="card-body"><span class="eyebrow"><span class="n">03</span> Desk layouts</span><h3><a href="/desk-layouts/">Nine ways to build a desk</a></h3><p>Docks, one tiling tree, a strip, drawers and palettes, laid out live as width and height run out.</p></div>
      </article>
      <article class="card">
        <div class="thumb"><div class="t-win" aria-hidden="true"><div class="t-bar" id="thumb-bar"><span class="t-group"><i class="t-g"></i><b style="width:46px"></b></span><span class="t-group"><i class="t-g"></i><b></b><b></b><b></b></span><span class="t-group"><i class="t-g"></i><b></b><b class="on"></b></span><span class="t-group"><i class="t-g"></i><b style="width:30px"></b></span></div><div class="t-doc"><span></span></div></div></div>
        <div class="card-body"><span class="eyebrow"><span class="n">04</span> Toolbar groups</span><h3><a href="/toolbar-groups/">One handle per group</a></h3><p>Five hosts, three zones, floating and collapsing groups, all from one drag handle each.</p></div>
      </article>
    </div>
    <p class="explore-k">Try it all · both packages</p>
    <div class="cards one">
      <article class="card wide">
        <div class="thumb"><svg viewBox="0 0 280 150" width="280" height="150" aria-hidden="true"><g class="lab-tiles"><rect x="14" y="14" width="76" height="58" rx="5"/><rect x="100" y="14" width="76" height="26" rx="5"/><rect x="186" y="14" width="80" height="58" rx="5"/><rect x="100" y="50" width="76" height="22" rx="5"/><rect x="14" y="82" width="120" height="54" rx="5"/><rect x="144" y="82" width="122" height="54" rx="5"/></g></svg></div>
        <div class="card-body"><span class="eyebrow">Lab</span><h3><a href="/lab/">The lab</a></h3><p>16 interactive demos for both packages, from the settle to ten kit cases, and a checks page that runs every scenario.</p></div>
      </article>
    </div>
  </section>

  <!-- The closing band: the two packages in one line, with a seam to drag (components/Poster.astro), just before the FAQ. -->
  <div class="wrap section poster-band">
    <Poster />
  </div>

  <Faq path="/" wrap />
</Site>

<script>
  import { whenVisible } from "../islands/rail";
  // The desk demo starts when it scrolls into view.
  const fig = document.getElementById("demo-fig")!;
  whenVisible(fig, () => void import("../islands/home").then((m) => m.startHero(fig)));
  // The telemetry island starts when the desk's legend (right under the desk) scrolls into view: it owns the slow-motion
  // control there, and fills the two panes further down, which listen to the desk once it runs.
  const tele = document.getElementById("tele")!;
  const strip = document.getElementById("tstrip")!;
  whenVisible(strip, () => void import("../islands/telemetry").then((m) => m.startTelemetry(tele, strip)));
  // The poster's seam starts when the poster scrolls into view.
  const poster = document.getElementById("poster")!;
  whenVisible(poster, () => void import("../islands/poster").then((m) => m.startPoster(poster)));
  // The hero is on screen from the first paint, and the server already drew its finished state: its island starts once the
  // page has loaded and the browser is idle, so it never competes with the first paint.
  const band = document.getElementById("band")!;
  const start = (): void => void import("../islands/hero").then((m) => m.startHero(band));
  const idle = (): void => void ("requestIdleCallback" in window ? requestIdleCallback(start, { timeout: 1500 }) : setTimeout(start, 300));
  if (document.readyState === "complete") idle();
  else addEventListener("load", idle, { once: true });
</script>
