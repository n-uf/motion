---
// /design/: the living style guide. Every value here is read from src/styles/tokens.css at build time and every
// sample uses the site's own classes and components, so the guide can't drift from the site. Kept out of search
// (noindex, not in the sitemap) and linked only from the footer.
import Site from "../layouts/Site.astro";
import CaseRail from "../components/CaseRail.astro";
import Chrome from "../components/Chrome.astro";
import DropModeSwitch from "../components/DropModeSwitch.astro";
import Playback from "../components/Playback.astro";
import { arrangement } from "../demos/toolbar";
import { orgNode } from "../data/schema";
import { CASES, windowHTML } from "../demos/toolbar";
import tokensCss from "../styles/tokens.css?raw";
import "../styles/toolbar-groups.css";
import "../styles/design.css";

/** The custom properties of the first block that matches `selector` in tokens.css. */
function block(selector: string): Map<string, string> {
  const at = tokensCss.indexOf(selector);
  const body = tokensCss.slice(tokensCss.indexOf("{", at) + 1, tokensCss.indexOf("}", at));
  const out = new Map<string, string>();
  for (const m of body.matchAll(/--([\w-]+):\s*([^;]+);/g)) out.set(m[1]!, m[2]!.trim());
  return out;
}
const light = block(":root {");
const dark = block(':root[data-theme="dark"] {');
const pick = (prefix: RegExp) => [...light.keys()].filter((k) => prefix.test(k));
const groups: [string, string, string[]][] = [
  ["Backgrounds", "Paper in light, graphite in dark. Raised for frames and cards, sunken for stages.", pick(/^bg/)],
  ["Text", "Three steps: primary, secondary, tertiary.", pick(/^text/)],
  ["Hairlines", "Solid 1 px lines, three strengths.", pick(/^line/)],
  ["Accent", "One blue teal, for interaction and focus only, on the site and in the demo windows.", pick(/^accent/)],
  ["Signal", "Orange, for drop targets and indicators only.", pick(/^signal/)],
  ["Results and series", "Good and bad results; chart series (the proposal takes the accent).", [...pick(/^(good|bad)$/), ...pick(/^series/)]],
  ["Grips", "The drag handle's dots, at rest and hot.", pick(/^grip/)],
  ["Window chrome", "Demo windows: bars a step lighter than the well, a lifted paper with readable lines, coloured lights.", pick(/^win/)],
  ["Diagrams", "The desk and drag stages' fills.", pick(/^d-/)],
];
const resolve = (map: Map<string, string>, v: string): string => {
  const m = v.match(/^var\(--([\w-]+)\)$/);
  return m ? resolve(map, map.get(m[1]!) ?? light.get(m[1]!) ?? v) : v;
};
const type = [
  ["t-2xl", "Page title (h1)", "h1"], ["t-xl", "Section title (h2)", "h2"], ["t-lg", "Card title", "lg"], ["t-md", "Lead, small headings", "md"],
  ["t-base", "Body", "base"], ["t-sm", "Interface, captions", "sm"], ["t-xs", "Notes", "xs"], ["t-2xs", "Eyebrow", "eyebrow"],
];
const space = pick(/^s\d$/);
const radii = pick(/^r(-|$)/);
const shadows = pick(/^shadow/);
---
<Site title="Design: the site's tokens and parts | n-uf motion" description="The living style guide of the n-uf motion site: palette, type scale, spacing, radii, shadows, the page shell, the figure's anatomy and the grip's states." path="/design/" headline="The site's design system" eyebrow="Style guide" jsonLd={[orgNode]} noindex>
  <p class="lead" slot="lead">Check here before adding UI. Every value below is read from <code>src/styles/tokens.css</code> when the site builds, and every sample is the site's own markup and classes, so this page can't drift from the pages it describes. Calm, precise, editorial-technical: warm paper in light, deep graphite in dark, one accent and one signal.</p>

  <section class="section">
    <div class="section-head"><span class="eyebrow">Palette</span><p class="section-title">Colours, light and dark</p></div>
    {groups.map(([name, note, keys]) => (
      <div class="ds-group">
        <h2>{name}</h2>
        <p class="muted">{note}</p>
        <div class="ds-swatches">
          {keys.map((k) => {
            const l = resolve(light, light.get(k)!), d = resolve(dark, dark.get(k) ?? light.get(k)!);
            return (
              <div class="ds-swatch">
                <div class="ds-chips"><i style={`background:${l}`}></i><i style={`background:${d}`}></i></div>
                <code>--{k}</code>
                <span class="ds-val">{light.get(k)}<br />{dark.get(k) ?? "same"}</span>
              </div>
            );
          })}
        </div>
      </div>
    ))}
  </section>

  <section class="section">
    <div class="section-head"><span class="eyebrow">Type</span><p class="section-title">The type scale</p><p>The system UI stack (<code>--font-sans</code>) and its monospace (<code>--font-mono</code>); headings at weight 650 with tight tracking, tabular figures for values.</p></div>
    <div class="ds-type">
      {type.map(([k, use, kind]) => (
        <div class="ds-type-row">
          <span class="ds-meta"><code>--{k}</code> {light.get(k!)}<br /><span class="muted">{use}</span></span>
          {kind === "eyebrow" ? <span class="eyebrow"><span class="n">02</span> Drag intent</span>
            : kind === "h1" ? <p class="ds-h1">Settle, never overshoot</p>
            : kind === "h2" ? <p class="ds-h2">The rules</p>
            : <p style={`font-size:var(--${k})`}>Every glide launches from where the window is drawn.</p>}
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head"><span class="eyebrow">Spacing, radii, shadows</span><p class="section-title">The scales</p></div>
    <div class="ds-scales">
      <div class="ds-group"><h2>Spacing</h2><div class="ds-space">{space.map((k) => <div><i style={`width:var(--${k});height:var(--${k})`}></i><code>--{k}</code><span class="ds-val">{light.get(k)}</span></div>)}</div></div>
      <div class="ds-group"><h2>Radii</h2><div class="ds-radii">{radii.map((k) => <div><i style={`border-radius:var(--${k})`}></i><code>--{k}</code><span class="ds-val">{light.get(k)}</span></div>)}</div></div>
      <div class="ds-group"><h2>Shadows</h2><div class="ds-shadows">{shadows.map((k) => <div><i style={`box-shadow:var(--${k})`}></i><code>--{k}</code></div>)}</div></div>
    </div>
  </section>

  <section class="section">
    <div class="section-head"><span class="eyebrow">Controls</span><p class="section-title">Buttons, switches, segments</p></div>
    <div class="ds-controls">
      <button type="button" class="btn">Button</button>
      <button type="button" class="btn primary">Primary</button>
      <button type="button" class="btn quiet">Quiet</button>
      <span class="seg"><button type="button" aria-pressed="true">This model</button><button type="button" aria-pressed="false">Naive</button></span>
      <label class="field"><input type="checkbox" class="switch" checked /> Switch</label>
      <label class="field">Range <input type="range" min="0" max="100" value="40" style="--fill:40%" /><output>40</output></label>
      <label class="field"><span class="label">Select</span><select><option>¼×</option><option>1×</option></select></label>
      <span><kbd>Alt</kbd> <code>npm i @n-uf/motion</code></span>
    </div>
  </section>

  <section class="section">
    <div class="section-head"><span class="eyebrow">Page shell</span><p class="section-title">The figure's anatomy</p><p>Every interactive page: eyebrow, h1 and lead in the page head, then one figure, a window (<code>components/Chrome.astro</code>). Its title bar starts with the window grip and the coloured lights; every control lives in a toolbar group led by a compact dot handle, in the title bar, a top or bottom bar, an edge, or floating, and a visitor can drag, collapse and rearrange them (the arrangement is remembered per figure; right-click a handle for <b>Reset position</b>). Between the bars: a numbered case rail exactly as tall as the stage (it scrolls; under 900 px it becomes a strip) and the stage on the flat well. Long status lines go under the window. Then an h2 per rule, and the pager. This sample is live.</p></div>
    <Chrome id="ds-figure" label="Figure anatomy" class="ds-anatomy" lock
      groups={[{ id: "title", name: "Title" }, { id: "actions", name: "Actions" }, { id: "preview", name: "Preview" }, { id: "speed", name: "Speed" }, { id: "tempo", name: "Tempo" }, { id: "readout", name: "Readout" }, { id: "hint", name: "Hint" }]}
      model={arrangement({ title: { start: ["title"], end: ["actions"] }, top: { start: ["preview"], end: ["speed", "tempo"] }, bottom: { start: ["readout"], end: ["hint"] } })}>
      <span class="ident" slot="title"><span class="name">Title group</span><span class="page">mono metadata</span></span>
      <Fragment slot="actions"><span class="lab">Group</span><button type="button" class="tb text">Action</button><button type="button" class="tb text" aria-pressed="true">On</button></Fragment>
      <Fragment slot="preview"><DropModeSwitch /></Fragment>
      <Fragment slot="speed"><Playback part="speed" /></Fragment>
      <Fragment slot="tempo"><Playback part="tempo" /></Fragment>
      <span class="mono" slot="readout">readout · <b>265 × 316</b> · at rest</span>
      <span class="quiet" slot="hint">a quiet hint in the end zone</span>
      <div class="figure-body" style="--stage-h: 260px">
        <CaseRail id="ds-cases" label="Example cases" items={[{ name: "Case rail", note: "Numbered cases, one pressed." }, { name: "A second case", note: "Its note under the name.", tag: "default" }, { name: "A third case", note: "The rail scrolls when it runs out of room." }]} />
        <div class="stage-wrap stage-host"><div class="ds-stage">Stage: the demo's own drawing, on the flat well</div></div>
      </div>
    </Chrome>
    <div class="rules two ds-rules">
      <div class="rule"><h3>A rule's question</h3><p>Its answer, in plain words, beside it. On a page each rule is its own h2.</p></div>
    </div>
  </section>

  <section class="section">
    <div class="section-head"><span class="eyebrow">Demo window</span><p class="section-title">The window chrome</p><p>The window every demo draws: coloured lights (<code>--win-light-1…3</code>), bars on <code>--win-bar</code> over the <code>--win-well</code>, a lifted paper (<code>--win-paper</code>) with lines in <code>--win-paper-line</code>. The active tool is an accent ring, hover a soft accent tint. This is the toolbar page's own markup, at rest.</p></div>
    <div class="ds-window-wrap"><div id="win" class="win" set:html={windowHTML(CASES[0]!.m)} /></div>
  </section>

  <section class="section">
    <div class="section-head"><span class="eyebrow">Grip</span><p class="section-title">The drag handle's states</p><p>3 px dots with 2 px gaps: compact (one line of 3) on groups, full (2×3) on title bars. Muted at rest, darker on hover or focus, accent while dragging. Frozen, grips are hidden; holding Alt brings them back.</p></div>
    <div class="ds-grips">
      <div><span class="g c" aria-hidden="true"><i></i><i></i><i></i></span><span class="muted">compact, rest</span></div>
      <div><span class="g full" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span><span class="muted">full, rest</span></div>
      <div><span class="g c is-hot" aria-hidden="true"><i></i><i></i><i></i></span><span class="muted">hover or focus</span></div>
      <div><span class="g c drag" aria-hidden="true"><i></i><i></i><i></i></span><span class="muted">dragging</span></div>
      <div><span class="ds-frozen" aria-hidden="true"></span><span class="muted">frozen: hidden</span></div>
    </div>
  </section>
</Site>

<script>
  // The anatomy and the window sample are live: the same chrome module as every figure.
  import { figureChrome } from "../islands/figure-chrome";
  import { createChrome } from "../islands/chrome";
  import { CASES, GROUPS } from "../demos/toolbar";
  figureChrome(document.getElementById("ds-figure")!);
  createChrome({ root: document.getElementById("win")!, labels: Object.fromEntries(Object.entries(GROUPS).map(([k, g]) => [k, g.label])), initial: CASES[0]!.m });
</script>
