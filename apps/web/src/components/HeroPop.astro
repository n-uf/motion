---
// The home hero's placement diagram: four cases of one rule, each one call of `positionPopup` (flip, slide and resize
// on). Static: the server draws what the function returns for each case, and the words under each are read off
// `Positioned`. The dashed bounds are where the popup must stay; the red dashes are where the rule first asked for it,
// when that did not fit; the solid card is where it went. Text is HTML (12 px) so it never scales with the drawing.
import { ANCHOR, CASE, CASES } from "../demos/hero-pop";
---
<div class="hz p"><div class="zin popzone" id="popzone">
  <div class="pcases" role="group" aria-label="One rule, four cases: room below, flipped up, slid left, resized to fit">
    {CASES.map((c) => (
      <figure class="pcase">
        <svg viewBox={`0 0 ${CASE.width} ${CASE.height}`} aria-hidden="true">
          <rect class="pc-bounds" x={c.bounds.x} y={c.bounds.y} width={c.bounds.width} height={c.bounds.height} rx="3" />
          {c.ghost && <rect class="pc-ghost" x={c.ghost.x} y={c.ghost.y} width={c.ghost.width} height={c.ghost.height} rx="5" />}
          <rect class="pc-anchor" x={c.anchor.x} y={c.anchor.y} width={ANCHOR.width} height={ANCHOR.height} rx="4" />
          <path class="pc-caret" d={`M${c.anchor.x + ANCHOR.width / 2 - 4} ${c.anchor.y + 6} l4 4 4 -4`} />
          <g class="pc-pop">
            <rect x={c.result.rect.x + 0.75} y={c.result.rect.y + 0.75} width={c.result.rect.width - 1.5} height={c.result.rect.height - 1.5} rx="5" />
            {[10, 21, 32].map((dy, i) => <rect class="ln" x={c.result.rect.x + 8} y={c.result.rect.y + dy} width={Math.max(0, (c.result.rect.width - 16) * (i === 1 ? 0.6 : 1))} height="4" rx="2" />)}
          </g>
        </svg>
        <figcaption><span class="n">{c.n}</span> {c.said}</figcaption>
      </figure>
    ))}
  </div>
  <p class="plegend"><span><i class="k solid"></i>where it went</span> <span><i class="k ask"></i>where the rule first asked</span></p>
  <code class="fn">positionPopup(anchor, size, bounds, rule) → rect</code>
  <div class="cap"><b>Popup</b> · one rule, four cases</div>
</div></div>
