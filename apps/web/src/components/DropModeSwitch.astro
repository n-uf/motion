---
// The drop preview switch every drag demo has: "Snap to slot" (the default) or "Drop indicator". The island binds it
// (src/islands/drop-mode.ts) and restores the visitor's last choice.
---
<span class="seg" role="group" aria-label="Drop preview">
  <button type="button" data-drop-mode="snap" aria-pressed="true">Snap to slot</button><button type="button" data-drop-mode="indicator" aria-pressed="false">Drop indicator</button>
</span>
