---
// The drop preview switch every drag demo has, as bar buttons: "Drop indicator · Open gap · Snap to slot" (Snap to
// slot is the default). The island binds it (islands/drop-mode.ts) and restores the visitor's last choice.
---
<span class="lab">Preview</span><button type="button" class="tb text" data-drop-mode="indicator" aria-pressed="false" title="Drop indicator: nothing moves; an outline or marker shows where it lands">Drop indicator</button><button type="button" class="tb text" data-drop-mode="gap" aria-pressed="false" title="Open gap: the neighbours make room; the item stays under the pointer">Open gap</button><button type="button" class="tb text" data-drop-mode="snap" aria-pressed="true" title="Snap to slot: the gap opens and the item glides into it">Snap to slot</button>
