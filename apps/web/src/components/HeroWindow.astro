---
// The home hero's shared window: one app window where the three libraries each do their part, each marked in its own
// colour. Docking (rose) lays it out from a real `solve` (today's @n-uf/placement/scene): the bar and its toolbar groups,
// the » menu, the columns, the panels in the form they took. Placement (violet) places the Share menu with
// `positionPopup`: it flips up, and the dashed ghost is where "below" would have gone. Motion (cyan) is the only thing
// that moves: the Inspector is dropped near its slot and glides in (islands/hero-window.ts). The server draws the
// finished state (the Inspector in its slot, the path shown), so with no script, or with reduced motion, it is a complete
// still. The frame is the window; the strip under it is room for the ghost, which crosses its bottom edge.
import { BELOW, MENU_ITEMS, STAGE, STRIP, groups, windowed } from "../demos/hero-window";

const { layout: l, share, slot, drop, said } = windowed();
const bar = l.edges.bar!;
const menu = bar.menu;
const H = STRIP + STAGE.height;
// The path runs corner to corner (the panel's top-left, dropped and in its slot), so it shows beside the panel, not under it.
const from = { x: drop.x + 6, y: drop.y + 4 }, to = { x: slot.x + 6, y: slot.y + 4 };
const rows = [
  { id: "d", key: "Docking", text: said },
  { id: "p", key: "Placement", text: share.flipped ? "The menu flips up, because below would leave the window." : "The menu opens below the button." },
  { id: "m", key: "Motion", text: "The dropped panel glides into its slot and settles." },
];
const files = ["Quarterly plan", "Budget", "Roadmap"];
const tint = (r: { x: number; y: number; width: number; height: number }) => ({ x: r.x, y: r.y, width: r.width, height: r.height });
const col = (id: "left" | "right") => tint(l.edges[id]!.rect);
---
<section class="wrap hwin" id="hwin" aria-label="One app window, three libraries">
  <div class="hwin-grid">
    <figure class="hwin-fig">
      <svg viewBox={`0 0 ${STAGE.width} ${H + BELOW}`} role="img" aria-label="An app window. Docking laid it out: a bar with the File and Edit toolbar groups and View in the » menu, a left column with Files open and Outline folded to its header, the document in the middle and a right column for the Inspector. Placement placed the Share menu, which flips up because below would leave the window. Motion glides the dropped Inspector panel into its slot.">
        <defs><clipPath id="hw-clip"><rect x="0" y={-STRIP} width={STAGE.width} height={H} rx="10" /></clipPath></defs>
        <rect class="hw-win" x="0" y="0" width={STAGE.width} height={H} rx="10" />
        <line class="hw-strip" x1="0" x2={STAGE.width} y1={STRIP} y2={STRIP} />
        {[12, 25, 38].map((x) => <circle class="hw-dot" cx={x} cy={STRIP / 2} r="3.5" />)}
        <g transform={`translate(0 ${STRIP})`}>
          <!-- Docking: the bar, the columns, the panels, the » menu (clipped to the window's rounded corners). -->
          <g clip-path="url(#hw-clip)">
          <rect class="hw-bar" x="0" y="0" width={STAGE.width} height={bar.rect.height} />
          <rect class="hw-col" {...col("left")} />
          <rect class="hw-col" {...col("right")} />
          <rect class="hw-doc" {...tint(l.content)} />
          {groups.map((g) => {
            const it = l.items[g.id]!;
            if (it.inMenu) return null;
            return (
              <g>
                <rect class="hw-chip" x={it.rect.x} y={it.rect.y + 3} width={it.rect.width} height={it.rect.height - 6} rx="6" />
                <text class="hw-t" x={it.rect.x + 12} y={it.rect.y + 20}><tspan class="b">{g.label}</tspan><tspan class="w" dx="12">{g.words.join("   ")}</tspan></text>
              </g>
            );
          })}
          {menu && menu.items.length > 0 && (
            <g>
              <rect class="hw-chip dk" x={menu.rect.x} y={menu.rect.y + 3} width={menu.rect.width} height={menu.rect.height - 6} rx="6" />
              <text class="hw-t b dkt" x={menu.rect.x + menu.rect.width / 2} y={menu.rect.y + 20} text-anchor="middle">»</text>
            </g>
          )}
          <rect class="hw-mark dk" x="1" y="1" width={STAGE.width - 2} height={bar.rect.height - 2} rx="4" />
          {(["files", "outline"] as const).map((id) => {
            const it = l.items[id]!;
            const open = it.formKind === "open";
            return (
              <g>
                <rect class="hw-panel dk" x={it.rect.x + 6} y={it.rect.y + 4} width={it.rect.width - 12} height={it.rect.height - 8} rx="7" />
                <text class="hw-t b" x={it.rect.x + 18} y={it.rect.y + (open ? 26 : 18)}>{id === "files" ? "Files" : "Outline"}</text>
                {open && files.map((f, i) => <text class="hw-t w" x={it.rect.x + 18} y={it.rect.y + 56 + i * 24}>{f}</text>)}
              </g>
            );
          })}
          <rect class="hw-slot dk" x={slot.x + 6} y={slot.y + 4} width={slot.width - 12} height={slot.height - 8} rx="7" />
          </g>
          <!-- The document, and Placement's Share button with its menu. -->
          <text class="hw-t w" x={l.content.x + 22} y={l.content.y + 26}>Document</text>
          <text class="hw-h" x={l.content.x + 22} y={l.content.y + 62}>Quarterly plan</text>
          {["Three small libraries do three jobs:", "one moves things, one fits them,", "one keeps who sits where."].map((t, i) => <text class="hw-t" x={l.content.x + 22} y={l.content.y + 92 + i * 24}>{t}</text>)}
          <rect class="hw-ghost" x={share.ghost.x} y={share.ghost.y} width={share.ghost.width} height={share.ghost.height} rx="7" />
          <rect class="hw-share" x={share.anchor.x} y={share.anchor.y} width={share.anchor.width} height={share.anchor.height} rx="7" />
          <text class="hw-t b sh" x={share.anchor.x + 14} y={share.anchor.y + 20}>Share</text>
          <path class="hw-caret" d={`M${share.anchor.x + 55} ${share.anchor.y + 13} l4 4 4 -4`} />
          <rect class="hw-menu" x={share.popup.x} y={share.popup.y} width={share.popup.width} height={share.popup.height} rx="7" />
          {MENU_ITEMS.map((t, i) => <text class="hw-t" x={share.popup.x + 16} y={share.popup.y + 30 + i * 28}>{t}</text>)}
          <!-- Motion: the path from where the Inspector was dropped, and the panel itself. -->
          <path class="hw-path" d={`M${from.x} ${from.y} L${to.x} ${to.y}`} />
          <circle class="hw-drop" cx={from.x} cy={from.y} r="5" />
          <svg class="hw-insp" id="hw-insp" x={slot.x + 6} y={slot.y + 4} width={slot.width - 12} height={slot.height - 8} data-slot={`${slot.x + 6},${slot.y + 4},${slot.width - 12},${slot.height - 8}`} data-drop={`${drop.x + 6},${drop.y + 4}`}>
            <rect class="hw-panel mo" x="1" y="1" width="100%" height="100%" rx="7" style="width: calc(100% - 2px); height: calc(100% - 2px)" />
            <text class="hw-t b" x="14" y="22">Inspector</text>
            <text class="hw-t w" x="14" y="52">Width    {Math.round(slot.width - 12)}</text>
            <text class="hw-t w" x="14" y="76">Zone     right column</text>
          </svg>
        </g>
        <rect class="hw-frame" x="0.5" y="0.5" width={STAGE.width - 1} height={H - 1} rx="10" />
      </svg>
    </figure>
    <ol class="hwin-notes">
      {rows.map((r) => <li class={`hwin-note ${r.id}`}><b>{r.key}</b><span>{r.text}</span></li>)}
    </ol>
  </div>
</section>
