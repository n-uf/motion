---
// The home page's live demo: the lab's Document window (apps/lab/src/docwin), live and as it is in the lab, not a copy.
// islands/home.ts `startHero` mounts `createDocwin` from the lab's own module into `#dw-win` once the figure scrolls into
// view: a DockState of @n-uf/docking, drawn from `solve`, dragged by grip with @n-uf/motion/drag over docking's `targets`
// and the landing model, its moves glided by @n-uf/motion. Until then (and without script) the slot shows the static
// miniature of the same window that the hero already draws (demos/hero-doc.ts), in a box of the demo's own height, so
// nothing shifts when the live window takes its place and the page has the window in its HTML.
import { docWindow } from "../demos/hero-doc";
import "../../../lab/src/docwin/docwin.css";

interface Props {
  /** The figure's id. */
  id: string;
  label: string;
}
const { id, label } = Astro.props;
const SIZE = { width: 440, height: 290 };
const still = docWindow(SIZE);
---
<figure class="docdemo" id={id} aria-label={label}>
  <div class="docdemo-slot" id="docdemo-slot">
    <div class="docdemo-still">
      <figure class="hdw" style={`--hd-w:${SIZE.width};--hd-h:${SIZE.height}`} role="img" aria-label="The document window at rest: a title bar with a zoom toolbar, Pages and Notes on the left, the page with a floating toolbar, Findings on the right, and a bottom bar.">
        <div class="hdw-in" aria-hidden="true"><div class="hd-win" set:html={still.html}></div></div>
      </figure>
    </div>
    <div class="dw" id="dw-root" hidden><div class="dw-win" id="dw-win"></div></div>
  </div>
  <div class="docdemo-foot">
    <p class="dw-status docdemo-status" id="dw-status" role="status" aria-live="polite"></p>
    <button type="button" class="docdemo-reset" id="dw-reset" title="Put the window back as it started">↺ Reset</button>
  </div>
</figure>
