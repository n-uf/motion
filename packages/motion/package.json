{
  "name": "@n-uf/motion",
  "version": "26.11.2",
  "description": "One frame loop with an injected clock, fine-grained signals, springs and tweens, and a DOM-free gesture recogniser. No DOM, no framework.",
  "keywords": [
    "animation",
    "motion",
    "spring",
    "spring-physics",
    "tween",
    "easing",
    "signals",
    "reactive",
    "frame-loop",
    "requestanimationframe",
    "scheduler",
    "gesture",
    "gesture-recognizer",
    "pointer-events",
    "drag",
    "long-press",
    "double-click",
    "pinch-zoom",
    "wheel",
    "fake-clock"
  ],
  "license": "LicenseRef-PolyForm-Perimeter-1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n-uf/motion.git",
    "directory": "packages/motion"
  },
  "homepage": "https://github.com/n-uf/motion#readme",
  "bugs": {
    "url": "https://github.com/n-uf/motion/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./clock": {
      "types": "./src/clock/index.ts",
      "default": "./src/clock/index.ts"
    },
    "./signals": {
      "types": "./src/signals/index.ts",
      "default": "./src/signals/index.ts"
    },
    "./values": {
      "types": "./src/values/index.ts",
      "default": "./src/values/index.ts"
    },
    "./gestures": {
      "types": "./src/gestures/index.ts",
      "default": "./src/gestures/index.ts"
    },
    "./browser": {
      "types": "./browser.ts",
      "default": "./browser.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./clock": {
        "types": "./dist/clock.d.ts",
        "default": "./dist/clock.js"
      },
      "./signals": {
        "types": "./dist/signals.d.ts",
        "default": "./dist/signals.js"
      },
      "./values": {
        "types": "./dist/values.d.ts",
        "default": "./dist/values.js"
      },
      "./gestures": {
        "types": "./dist/gestures.d.ts",
        "default": "./dist/gestures.js"
      },
      "./browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node ./scripts/check-dist.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "bench": "node ./bench/run.mjs && node ./bench/compare.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepack": "pnpm run build",
    "release:next-version": "node ./scripts/calendar-version-bump.mjs --dry-run",
    "version:bump": "node ./scripts/calendar-version-bump.mjs --apply"
  },
  "dependencies": {
    "alien-signals": "^3.2.1"
  },
  "devDependencies": {
    "@preact/signals-core": "1.14.5",
    "@types/node": "^25.5.0",
    "esbuild": "^0.28.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
