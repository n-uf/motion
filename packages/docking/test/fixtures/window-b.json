{
  "_about": "Window B: the same shape of window as window-a (pages area + panels pages/annotations/findings) with narrower cards and a flush layout: card 200..560 wide, NO gap, NO stage padding, a 32 px rail. Same fixture format as window-a.json. Pinned outcomes from a real window of this shape.",
  "_numbers": {
    "contentMin": { "width": 320, "height": 240 },
    "card": { "cross": { "min": 200, "max": 560 } },
    "gap": 0,
    "padding": 0,
    "rail": { "width": 32, "slot": 32 },
    "sheetBelow": 520,
    "sheetRule": "host fallback: stage width < contentMin 320 + one card 200 = 520",
    "arithmetic": "one open beside a rail: 320 + 200 + 32 = 552; all open: 320 + 200 + 200 = 720 (a stack costs its widest member, so three panels cost the same as two)"
  },
  "states": {
    "three": {
      "_about": "Pages above Annotations in one left column, Findings on the right; use order pages < annotations < findings; all open.",
      "state": {
        "stage": { "x": 0, "y": 0, "w": 1120, "h": 800 },
        "contentMin": { "width": 320, "height": 240 },
        "handFold": "bar",
        "floatKinds": ["panel"],
        "columns": {
          "left": { "accepts": ["panel"], "cross": { "min": 200, "max": 560, "rail": 32 }, "gap": 0 },
          "right": { "accepts": ["panel"], "cross": { "min": 200, "max": 560, "rail": 32 }, "gap": 0 }
        },
        "rails": { "left": { "width": 32, "accepts": ["panel"] }, "right": { "width": 32, "accepts": ["panel"] } },
        "pad": { "start": 0, "end": 0 },
        "items": {
          "pages": { "kind": "panel", "used": 1, "forms": { "column": ["card", "bar", "rail"] }, "grows": 1 },
          "annotations": { "kind": "panel", "used": 2, "forms": { "column": ["card", "bar", "rail"] }, "grows": 1 },
          "findings": { "kind": "panel", "used": 3, "forms": { "column": ["card", "bar", "rail"] }, "grows": 1 }
        },
        "edges": [
          { "id": "left-0", "side": "left", "ring": 0, "column": true, "items": ["pages", "annotations"] },
          { "id": "right-0", "side": "right", "ring": 0, "column": true, "items": ["findings"] }
        ],
        "floats": []
      },
      "expect": [
        { "stage": { "w": 720, "h": 800 }, "layout": { "columns": { "left": [["pages", "annotations"]], "right": [["findings"]] }, "contentWidthAtLeast": 320 } },
        { "stage": { "w": 719, "h": 800 }, "layout": { "columns": { "left": [], "right": [["findings"]] }, "rails": { "left": ["pages", "annotations"], "right": [] }, "note": "the left stack folds whole into the left rail as two segments" } },
        { "stage": { "w": 552, "h": 800 }, "layout": { "columns": { "left": [], "right": [["findings"]] }, "rails": { "left": ["pages", "annotations"], "right": [] }, "contentWidthAtLeast": 320 } },
        { "stage": { "w": 551, "h": 800 }, "layout": { "columns": { "left": [], "right": [] }, "rails": { "left": ["pages", "annotations"], "right": ["findings"] } } },
        { "stage": { "w": 520, "h": 800 }, "layout": { "sheetFallback": false } },
        { "stage": { "w": 519, "h": 800 }, "layout": { "sheetFallback": true } }
      ]
    },
    "pair": {
      "_about": "Annotations left (older), Findings right (newer).",
      "state": {
        "extends": "three",
        "items": { "pages": null },
        "edges": [
          { "id": "left-0", "side": "left", "ring": 0, "column": true, "items": ["annotations"] },
          { "id": "right-0", "side": "right", "ring": 0, "column": true, "items": ["findings"] }
        ]
      },
      "expect": [
        { "stage": { "w": 720, "h": 800 }, "layout": { "columns": { "left": [["annotations"]], "right": [["findings"]] } } },
        { "stage": { "w": 719, "h": 800 }, "layout": { "columns": { "left": [], "right": [["findings"]] }, "rails": { "left": ["annotations"], "right": [] } } },
        { "stage": { "w": 590, "h": 800 }, "layout": { "columns": { "left": [], "right": [["findings"]] }, "rails": { "left": ["annotations"], "right": [] }, "note": "590 is above 552: one beside a rail, the older column folded" } },
        { "stage": { "w": 552, "h": 800 }, "layout": { "columns": { "left": [], "right": [["findings"]] } } },
        { "stage": { "w": 551, "h": 800 }, "layout": { "columns": { "left": [], "right": [] }, "rails": { "left": ["annotations"], "right": ["findings"] } } }
      ]
    }
  }
}
