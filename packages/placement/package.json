{
  "name": "@n-uf/placement",
  "version": "26.11.13",
  "description": "Where things go: desk docks, rails and palettes, panel columns, toolbar groups, and the drop targets for each. Pure state in, rects out. No DOM, no framework, no motion.",
  "keywords": [
    "layout",
    "docking",
    "dock",
    "panels",
    "palettes",
    "toolbar",
    "overflow",
    "drag-and-drop",
    "drop-targets",
    "positioner",
    "popup"
  ],
  "license": "LicenseRef-PolyForm-Perimeter-1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n-uf/motion.git",
    "directory": "packages/placement"
  },
  "homepage": "https://motion.n-uf.com",
  "bugs": {
    "url": "https://github.com/n-uf/motion/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./dock": {
      "types": "./src/dock/index.ts",
      "default": "./src/dock/index.ts"
    },
    "./toolbar": {
      "types": "./src/toolbar/index.ts",
      "default": "./src/toolbar/index.ts"
    },
    "./targets": {
      "types": "./src/targets/index.ts",
      "default": "./src/targets/index.ts"
    },
    "./panels": {
      "types": "./src/panels/index.ts",
      "default": "./src/panels/index.ts"
    },
    "./desk": {
      "types": "./src/desk/index.ts",
      "default": "./src/desk/index.ts"
    },
    "./stack": {
      "types": "./src/stack/index.ts",
      "default": "./src/stack/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./dock": {
        "types": "./dist/dock.d.ts",
        "default": "./dist/dock.js"
      },
      "./toolbar": {
        "types": "./dist/toolbar.d.ts",
        "default": "./dist/toolbar.js"
      },
      "./targets": {
        "types": "./dist/targets.d.ts",
        "default": "./dist/targets.js"
      },
      "./panels": {
        "types": "./dist/panels.d.ts",
        "default": "./dist/panels.js"
      },
      "./desk": {
        "types": "./dist/desk.d.ts",
        "default": "./dist/desk.js"
      },
      "./stack": {
        "types": "./dist/stack.d.ts",
        "default": "./dist/stack.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node ./scripts/check-dist.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
