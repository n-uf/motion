{
  "name": "@n-uf/placement",
  "version": "26.11.53",
  "description": "Where things go: a window's bars, rails, columns, items and floats solved into a layout, with the drop targets, refusals and lanes of every drag. Pure state in, rects out. No DOM, no framework, no motion.",
  "keywords": [
    "layout",
    "docking",
    "dock",
    "panels",
    "palettes",
    "toolbar",
    "overflow",
    "drag-and-drop",
    "drop-targets",
    "positioner",
    "popup"
  ],
  "license": "LicenseRef-PolyForm-Perimeter-1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n-uf/motion.git",
    "directory": "packages/placement"
  },
  "homepage": "https://motion.n-uf.com",
  "bugs": {
    "url": "https://github.com/n-uf/motion/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./stack": {
      "types": "./src/stack/index.ts",
      "default": "./src/stack/index.ts"
    },
    "./scene": {
      "types": "./src/scene/index.ts",
      "default": "./src/scene/index.ts"
    },
    "./scene/cases": {
      "types": "./src/scene/cases/index.ts",
      "default": "./src/scene/cases/index.ts"
    },
    "./tiling": {
      "types": "./src/tiling/index.ts",
      "default": "./src/tiling/index.ts"
    },
    "./popup": {
      "types": "./src/popup/index.ts",
      "default": "./src/popup/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./stack": {
        "types": "./dist/stack.d.ts",
        "default": "./dist/stack.js"
      },
      "./scene": {
        "types": "./dist/scene.d.ts",
        "default": "./dist/scene.js"
      },
      "./scene/cases": {
        "types": "./dist/scene-cases.d.ts",
        "default": "./dist/scene-cases.js"
      },
      "./tiling": {
        "types": "./dist/tiling.d.ts",
        "default": "./dist/tiling.js"
      },
      "./popup": {
        "types": "./dist/popup.d.ts",
        "default": "./dist/popup.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node ./scripts/check-dist.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@n-uf/motion": "workspace:*",
    "@types/node": "^25.5.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
